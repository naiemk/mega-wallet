# Mega Wallet API — copy to .env after install-api.sh
PORT=8080
DATABASE_URL=/data/mega-wallet.db
EVENT_LOG_PATH=/data/events.jsonl
S3_EVENT_LOG_BUCKET=
S3_EVENT_LOG_KEY=mega-wallet/events.jsonl
S3_EVENT_LOG_ENDPOINT=
FAKE_RAMPS=0
BETTER_AUTH_SECRET=change-me-min-32-chars-in-production
BETTER_AUTH_URL=https://pool.trustless-commerce.com
PUBLIC_API_URL=https://pool.trustless-commerce.com
PUBLIC_UI_URL=https://pool.trustless-commerce.com
INTERNAL_WORKER_TOKEN=change-me-worker-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPERATOR_SETTLEMENT_EMAIL=
AUTH_EMAIL_MODE=resend
RESEND_API_KEY=
RESEND_FROM=Pool Begir <onboarding@resend.dev>
TRUSTLESS_COMMERCE_URL=https://testnet.trustless-commerce.com
TRUSTLESS_COMMERCE_WEBHOOK_SECRET=
ONRAMPER_API_KEY=
ONRAMPER_SIGNING_KEY=
OPERATOR_WALLET_ETHEREUM=
OPERATOR_WALLET_BASE=
OPERATOR_WALLET_TRON=

# vibed-infra docker settings (leave HOST_PORT empty when nginx reaches the container on DOCKER_NETWORK)
DOCKER_NETWORK=mega-wallet-edge
DOCKER_NAME=mega-wallet-api
BACKEND_IMAGE=ghcr.io/naiemk/mega-wallet-api:main
HOST_PORT=
DATA_DIR=./data
API_MEMORY_LIMIT=512m
API_AUTO_UPDATE=1
API_AUTO_UPDATE_INTERVAL_MIN=30
API_STOP_TIMEOUT=60
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h
