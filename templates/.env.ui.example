# Mega Wallet UI — copy to .env after install-ui.sh
DOCKER_NETWORK=mega-wallet-edge
UI_NAME=mega-wallet-ui
UI_IMAGE=ghcr.io/naiemk/mega-wallet-ui:main
UI_MEMORY_LIMIT=32m
UI_AUTO_UPDATE=1
UI_AUTO_UPDATE_INTERVAL_MIN=20
UI_STOP_TIMEOUT=30
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h
