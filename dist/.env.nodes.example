# Mega Wallet worker — copy to .env after install-nodes.sh (INTERNAL_WORKER_TOKEN must match API)
API_URL=http://mega-wallet-api:8080
INTERNAL_WORKER_TOKEN=change-me-worker-token
WORKER_INTERVAL_MS=15000
DOCKER_NETWORK=mega-wallet-edge
WORKER_IMAGE=ghcr.io/naiemk/mega-wallet-worker:main
WORKER_CONTAINER_NAME=mega-wallet-worker
WORKER_MEMORY_LIMIT=64m
NODES_AUTO_UPDATE=1
NODES_AUTO_UPDATE_INTERVAL_MIN=30
NODES_STOP_TIMEOUT=30
DOCKER_AUTO_PRUNE=1
DOCKER_PRUNE_UNUSED=0
DOCKER_PRUNE_UNTIL=72h
