# Mega Wallet API
PORT=8080
DATABASE_URL=./data/mega-wallet.db
EVENT_LOG_PATH=./data/events.jsonl
S3_EVENT_LOG_BUCKET=
S3_EVENT_LOG_KEY=mega-wallet/events.jsonl
S3_EVENT_LOG_ENDPOINT=
FAKE_RAMPS=0
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080
PUBLIC_UI_URL=http://localhost:5173
INTERNAL_WORKER_TOKEN=dev-worker-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPERATOR_SETTLEMENT_EMAIL=
# Auth email: console (dev OTP file + logs) or resend
AUTH_EMAIL_MODE=resend
RESEND_API_KEY=
# Production: verified domain on Resend (onboarding@resend.dev only delivers to the account owner).
RESEND_FROM=Pool Begir <noreply@trustless-commerce.com>

# OAuth (optional — buttons hidden until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

# Telegram OIDC (BotFather → Bot Settings → Web Login; redirect /api/auth/callback/telegram)
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# Integrations (testnet by default)
TRUSTLESS_COMMERCE_URL=https://testnet.trustless-commerce.com
TRUSTLESS_COMMERCE_WEBHOOK_SECRET=
# Onramper keys optional — quotes go through TC public API
ONRAMPER_API_KEY=
ONRAMPER_SIGNING_KEY=
OPERATOR_WALLET_ETHEREUM=
OPERATOR_WALLET_BASE=
OPERATOR_WALLET_TRON=

# USDT→IRR FX oracle
FX_COMMISSION_BPS=100
FX_MAX_DEVIATION_BPS=200
FX_MIN_SOURCES=2
FX_MIN_RATE=100000
FX_MAX_RATE=20000000
FX_CACHE_TTL_MS=15000
FX_NEGATIVE_CACHE_MS=5000

