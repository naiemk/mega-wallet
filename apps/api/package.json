{
  "name": "@mega-wallet/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --config ../../vitest.config.ts apps/api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "ledger:rebuild": "tsx src/scripts/rebuild-ledger.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.2.8",
    "@hono/node-server": "^1.14.1",
    "@mega-wallet/core": "workspace:*",
    "better-auth": "^1.2.8",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.7",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
